{
  "name": "werewolf-v2-dev",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "werewolf-v2-backups" }],
  "durable_objects": {
    "bindings": [
      { "name": "CONTESTS", "class_name": "ContestDO" },
      { "name": "CATALOG", "class_name": "ContestCatalogDO" },
    ],
  },
  "migrations": [
    { "tag": "v2-contest-sqlite-1", "new_sqlite_classes": ["ContestDO", "ContestCatalogDO"] },
  ],
  "vars": {
    "ORGANIZER_PASSWORD": "local-development-only",
    "SESSION_SECRET": "local-session-secret-not-for-deployment",
  },
}
