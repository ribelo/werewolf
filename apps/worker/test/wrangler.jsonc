{
  "name": "werewolf-v2-test",
  "main": "../src/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "werewolf-v2-backups" }],
  "durable_objects": {
    "bindings": [
      { "name": "CONTESTS", "class_name": "ContestDO" },
      { "name": "CATALOG", "class_name": "ContestCatalogDO" },
    ],
  },
  "migrations": [
    { "tag": "v2-contest-sqlite-1", "new_sqlite_classes": ["ContestDO", "ContestCatalogDO"] },
  ],
  "vars": {
    "ORGANIZER_PASSWORD": "test-password",
    "SESSION_SECRET": "test-session-secret-not-for-deployment",
  },
}
